###

POST https://localhost.balazskrizsan.com:8080/api/v1/ses/send-templated
Content-Type: application/json
Authorization: Bearer {{$auth.token("smart_scrum_poker_aws")}}

{
  "to": "krizsan.balazs@gmail.com",
  "subject": "Test Templated Email",
  "htmlTemplate": "<h1>Hello ##name##</h1><p>This is a test email for ##company##.</p>",
  "textTemplate": "Hello ##name##, this is a test email for ##company##.",
  "templateVariables": {
    "name": "Balazs",
    "company": "SmartScrumPoker"
  }
}

