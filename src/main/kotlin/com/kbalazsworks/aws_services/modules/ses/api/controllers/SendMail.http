POST https://localhost.balazskrizsan.com:8080/api/v1/ses/send-templated-by-id
Content-Type: application/json
Authorization: Bearer {{$auth.token("smart_scrum_poker_aws")}}

{
  "to": "krizsan.balazs@gmail.com",
  "subject": "Test Templated Email by ID",
  "templateId": "complete-quick-registration",
  "templateVariables": {
    "email": "krizsan.balazs@gmail.com",
    "complitionUrl": "SmartScrumPoker"
  }
}
